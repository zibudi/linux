# The split this repo exists to control.
#
# Transports are builtin, so every bus enumerates itself with no help from
# userspace. Everything that actually speaks to a disk is a module, so init
# has to go find it and link it in. That is the case we want to be exercising
# -- a kernel that already had the driver would never tell us the loader was
# broken.

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y

# init loads these with finit_module straight off the initramfs. Nothing
# decompresses them for us, and nothing has a key to check them against.
CONFIG_MODULE_COMPRESS_NONE=y
# CONFIG_MODULE_SIG is not set

CONFIG_PCI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y

CONFIG_VIRTIO_BLK=m
CONFIG_BLK_DEV_NVME=m
CONFIG_BLK_DEV_SD=m
CONFIG_ATA=m
CONFIG_ATA_PIIX=m
CONFIG_SATA_AHCI=m
CONFIG_USB_STORAGE=m

CONFIG_EXT4_FS=m
CONFIG_FAT_FS=m
CONFIG_VFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_ISO8859_1=m

# The whole userspace arrives in the initramfs.
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y

# qemu -nographic has nowhere else to print.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
